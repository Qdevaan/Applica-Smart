# Frontend env. Copy to .env and edit for your machine.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ML server (FastAPI). Local dev:
#   VITE_ML_API_URL=http://localhost:8000
# Cross-machine via ngrok (run `ngrok http 8000` on the backend host):
#   VITE_ML_API_URL=https://<your-subdomain>.ngrok-free.app
VITE_ML_API_URL=http://localhost:8000
